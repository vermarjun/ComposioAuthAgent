# --- model (xypro proxies your ChatGPT Codex subscription) -------------------
XYPRO_BASE_URL=http://127.0.0.1:1455/v1
XYPRO_API_KEY=xypro
AGENT_MODEL=xypro/gpt-5.5

# --- oracles & research -----------------------------------------------------
COMPOSIO_API_KEY=
FIRECRAWL_API_KEY=

# --- optional capabilities (absent = the agent blocks honestly) -------------
AGENTMAIL_API_KEY=
CAPSOLVER_API_KEY=

# --- who the agent says it is when it registers an app ----------------------
APPLICANT_APP_NAME=Composio
APPLICANT_HOMEPAGE=https://composio.dev
APPLICANT_CONTACT_EMAIL=support@composio.dev
APPLICANT_PRIVACY_URL=https://composio.dev/privacy
OAUTH_REDIRECT_URI=https://backend.composio.dev/api/v1/auth-apps/add

# --- access control ---------------------------------------------------------
# Unset disables the gate entirely, which is what local development wants.
DASHBOARD_PASSWORD=
# Only when something in front actually rewrites x-forwarded-for. Trusting a
# client-set header hands an attacker unlimited password guesses.
TRUST_PROXY=false
# Set true when serving over plain http, so the session cookie is not Secure.
COOKIE_INSECURE=false

# --- operator identity ------------------------------------------------------
# Encrypts the per-platform account vault. Unset means the agent has no identity
# to log into a portal with, and blocks with needs_operator_account instead.
VAULT_KEY=
# OPERATOR_VAULT_PATH=runs/vault.enc

# --- behaviour --------------------------------------------------------------
# readonly = fill forms but never submit · register = submit on accounts you
# already hold (default) · full = also create new accounts
ACQUISITION_MODE=register
BROWSER_PROVIDER=agentcore     # or "local" for a browser in the container
# AGENTCORE_REGION=us-east-1
# AGENTCORE_PROFILE_ID=composio-operator
PORT=8080
# OPENCODE_PORT=4096

# --- AWS (unset = runs entirely on local disk) ------------------------------
# RUNS_TABLE=auth-agent-runs
# ARTIFACTS_BUCKET=auth-agent-artifacts
# AWS_REGION=us-east-1
