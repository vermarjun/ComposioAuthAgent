{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "xypro": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Xypro (ChatGPT Codex)",
      "options": {
        "baseURL": "{env:XYPRO_BASE_URL}",
        "apiKey": "{env:XYPRO_API_KEY}"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT-5.6-Luna"
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6-Terra"
        },
        "gpt-6-astra": {
          "name": "GPT-6-Astra"
        }
      }
    }
  },
  "model": "xypro/gpt-5.6-luna",
  "small_model": "xypro/gpt-5.6-luna",
  "mcp": {
    "browser": {
      "type": "local",
      "command": [
        "agent-browser",
        "mcp",
        "--tools",
        "core"
      ],
      "enabled": true
    }
  },
  "permission": {
    "edit": "deny",
    "write": "deny",
    "bash": "deny",
    "webfetch": "allow"
  }
}